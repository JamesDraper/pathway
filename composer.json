{
    "autoload": {
        "psr-4": {
            "Pathway\\": "src"
        }
    },
    "autoload-dev": {
        "files": ["tests/TestCase.php"],
        "psr-4": {
            "Tests\\Interfaces\\": "tests/interfaces",
            "Tests\\TypeFormatter\\": "tests/type-formatter",
            "Tests\\Info\\Type\\": "tests/info/type",
            "Tests\\Info\\Parameter\\": "tests/info/parameter",
            "Tests\\Info\\Method\\": "tests/info/method",
            "Tests\\Info\\Class\\": "tests/info/class",
            "Tests\\Defaults\\": "tests/defaults",
            "Tests\\Method\\": "tests/method",
            "Tests\\MethodChain\\": "tests/method-chain"
        }
    },
    "require": {
        "php": ">=8.5.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@php-cs-fixer"
        ],
        "phpunit": [
            "@phpunit.interfaces",
            "@phpunit.type-formatter",
            "@phpunit.info.type",
            "@phpunit.info.parameter",
            "@phpunit.info.method",
            "@phpunit.info.class",
            "@phpunit.defaults",
            "@phpunit.method",
            "@phpunit.method-chain"
        ],
        "phpunit.coverage": "phpunit --coverage-html coverage",
        "phpunit.interfaces": "phpunit --testsuite=interfaces",
        "phpunit.type-formatter": "phpunit --testsuite=interfaces",
        "phpunit.info.type": "phpunit --testsuite=info.type",
        "phpunit.info.parameter": "phpunit --testsuite=info.parameter",
        "phpunit.info.method": "phpunit --testsuite=info.method",
        "phpunit.info.class": "phpunit --testsuite=info.class",
        "phpunit.defaults": "phpunit --testsuite=defaults",
        "phpunit.method": "phpunit --testsuite=method",
        "phpunit.method-chain": "phpunit --testsuite=method-chain",
        "phpstan": "phpstan analyze",
        "php-cs-fixer": "php-cs-fixer fix -v --diff --dry-run"
    }
}
