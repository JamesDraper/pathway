{
    "autoload": {
        "psr-4": {
            "Pathway\\": "src"
        }
    },
    "autoload-dev": {
        "files": ["tests/TestCase.php"],
        "psr-4": {
            "Tests\\Interfaces\\": "tests/interfaces",
            "Tests\\TypeFormatter\\": "tests/type-formatter",
            "Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.5.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@php-cs-fixer"
        ],
        "phpunit": [
            "@phpunit.interfaces",
            "@phpunit.type-formatter",
            "@phpunit.unit"
        ],
        "phpunit.interfaces": "phpunit --testsuite=interfaces",
        "phpunit.type-formatter": "phpunit --testsuite=interfaces",
        "phpunit.unit": "phpunit --testsuite=unit",
        "phpstan": "phpstan analyze",
        "php-cs-fixer": "php-cs-fixer fix -v --diff --dry-run"
    }
}
